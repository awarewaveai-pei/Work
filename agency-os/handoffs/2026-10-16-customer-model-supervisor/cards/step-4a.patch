+    if (error) throw new Error(error.message);
+    expect(data[0].allowed).toBe(true);
+    expect((await send({ event_id: "refund-001", kind: "refund", target: "credit_pack", organization_id: CUSTOMER, order_ref: "O-1" })).body)
