+    const html = renderToStaticMarkup(await BillingPage());
+    expect(html).toContain("Payments Customer");
+    expect(html).toContain("social_basic");
+    expect(html).toContain("cb-001-cleared");
+    expect(html).not.toContain("讀不到帳務資料");
+  });
+});
diff --git a/lobster-factory/infra/hetzner-phase1-core/apps/next-admin/app/api/webhooks/payments/[provider]/route.ts b/lobster-factory/infra/hetzner-phase1-core/apps/next-admin/app/api/webhooks/payments/[provider]/route.ts
