{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DispatchAcknowledgement",
  "type": "object",
  "required": [
    "dispatch_id",
    "dispatch_version",
    "employee_id",
    "acknowledged_at"
  ],
  "properties": {
    "dispatch_id": {
      "type": "string"
    },
    "dispatch_version": {
      "type": "integer",
      "minimum": 1
    },
    "employee_id": {
      "type": "string"
    },
    "acknowledged_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
