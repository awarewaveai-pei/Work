# ════════════════════════════════════════════════
# 全自動內容發佈系統 — 環境變數範例
# 複製成 .env 後填值；或直接設定到 systemd EnvironmentFile / shell。
# 禁止把填好的 .env commit 進 git（已在用途上視為 secret）。
# 載入方式（任選）：
#   - shell:   set -a; source .env; set +a; python master_controller.py
#   - python:  pip install python-dotenv 後在 config.py 前自行載入
#   - cron:    systemd EnvironmentFile=/path/.env
# 沒填的欄位 → 對應平台/功能自動略過，不會報錯。
# ════════════════════════════════════════════════

# ── AI（必填）──
CLAUDE_API_KEY=
OPENAI_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_INPUT_PRICE_PER_MTOK=3
# CLAUDE_OUTPUT_PRICE_PER_MTOK=15

# ── Supabase（必填，當佇列/記錄用）──
SUPABASE_URL=
SUPABASE_KEY=

# ── WordPress（必填，是 hub：發文 + IG/Pinterest 圖片公開 URL 來源）──
WP_URL=
WP_USERNAME=
WP_PASSWORD=

# ── 圖片來源 ──
PIXABAY_API_KEY=

# ── YouTube ──
YOUTUBE_API_KEY=
# YOUTUBE_CLIENT_SECRETS=client_secrets.json
# YOUTUBE_TOKEN_FILE=youtube_token.json

# ── Meta（IG / FB / Threads）──
META_ACCESS_TOKEN=
META_INSTAGRAM_ID=
META_FACEBOOK_PAGE_ID=
META_THREADS_ID=

# ── LinkedIn ──
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_ID=

# ── TikTok（未審核 app 必須 SELF_ONLY，audited 後才可改 PUBLIC_TO_EVERYONE）──
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=
TIKTOK_PRIVACY=SELF_ONLY

# ── Pinterest ──
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=

# ── Reddit（自動發文易被 spam ban，預設關閉；確認 sub 規則後才開）──
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=autopublish/1.0
REDDIT_SUBREDDITS=
REDDIT_ENABLE=false

# ── Bluesky ──
BLUESKY_HANDLE=
BLUESKY_PASSWORD=

# ── 選題來源（逗號分隔）──
TRENDS_KEYWORDS=
REDDIT_FETCH_SUBS=
YOUTUBE_SEARCH_QUERIES=
NEWS_API_KEY=
NEWS_QUERIES=
GSC_SITE_URL=

# ── 品質控制 / 電子報 / 備份 / 通知 ──
COPYSCAPE_USER=
COPYSCAPE_API_KEY=
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
MAILCHIMP_FROM_NAME=
MAILCHIMP_FROM_EMAIL=
GDRIVE_FOLDER_ID=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ── 執行設定 ──
# MAX_TOPICS_PER_RUN=3
# PIPELINE_TIMEOUT=1800
