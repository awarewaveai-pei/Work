{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://system-foundry.local/schemas/control-plane-metadata.schema.json",
  "title": "Control Plane Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "foundry_kernel_version",
    "revision",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "foundry_kernel_version": {
      "const": "1.6.0"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
