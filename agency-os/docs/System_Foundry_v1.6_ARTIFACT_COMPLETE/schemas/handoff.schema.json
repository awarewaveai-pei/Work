{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://system-foundry.local/schemas/handoff.schema.json",
  "title": "Structured Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "handoff_id",
    "timestamp",
    "from",
    "to",
    "objective",
    "scope",
    "stage",
    "verified_facts",
    "decisions",
    "changed_artifacts",
    "tests",
    "risks",
    "rollback_position",
    "pending_tasks",
    "risk_tier"
  ],
  "properties": {
    "handoff_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "minLength": 1
    },
    "from": {
      "type": "string",
      "minLength": 1
    },
    "to": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "rollback_position": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verified_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "statement",
          "evidence"
        ],
        "properties": {
          "statement": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": ".+:[0-9]+(?:-[0-9]+)?$"
            }
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changed_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pending_tasks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_tier": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4"
      ]
    },
    "authority_context": {
      "type": "string"
    }
  }
}
