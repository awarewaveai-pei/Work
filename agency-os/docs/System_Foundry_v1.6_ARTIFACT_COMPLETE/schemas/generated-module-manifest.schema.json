{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generated Module Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "module_id",
    "status",
    "purpose",
    "activated_capabilities",
    "custom_requirements",
    "generated_paths",
    "required_documents",
    "invariants",
    "security_obligations",
    "test_obligations",
    "operational_obligations",
    "recovery_obligations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "module_id": {
      "type": "string"
    },
    "status": {
      "const": "SELECTED"
    },
    "purpose": {
      "type": "string"
    },
    "activated_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "generated_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "required_documents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "security_obligations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "test_obligations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "operational_obligations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "recovery_obligations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "custom_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
