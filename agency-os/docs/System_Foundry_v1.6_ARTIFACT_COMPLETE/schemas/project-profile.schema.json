{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Foundry Project Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "profile", "system_type", "criticality", "commercial", "multi_tenant", "regulated"],
  "properties": {
    "project_id": {"type": "string", "minLength": 1},
    "profile": {"enum": ["lite", "standard", "commercial", "enterprise"]},
    "system_type": {"type": "string", "minLength": 1},
    "criticality": {"enum": ["low", "medium", "high", "mission_critical"]},
    "commercial": {"type": "boolean"},
    "multi_tenant": {"type": "boolean"},
    "regulated": {"type": "boolean"},
    "expected_scale": {"type": "string"},
    "stack_profile": {"type": "string"}
  }
}
