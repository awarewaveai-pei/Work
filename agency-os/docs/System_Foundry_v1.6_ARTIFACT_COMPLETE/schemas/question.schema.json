{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Foundry Binary Question",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "category",
    "label",
    "answer_type",
    "required_when_active"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^Q-[A-Z0-9-]+$"
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "answer_type": {
      "const": "boolean"
    },
    "required_when_active": {
      "const": true
    },
    "active_when": {
      "type": "object"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
