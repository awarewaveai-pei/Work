{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://system-foundry.local/schemas/authority-grant.schema.json",
  "title": "Derived Authority Grant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grant_id",
    "actor",
    "risk_tier",
    "required_authority",
    "granted_authority",
    "scope",
    "expires_at",
    "granted_by",
    "approval_evidence"
  ],
  "properties": {
    "grant_id": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "risk_tier": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4"
      ]
    },
    "required_authority": {
      "enum": [
        "A0",
        "A1",
        "A2",
        "A3",
        "A4"
      ],
      "readOnly": true
    },
    "granted_authority": {
      "enum": [
        "A0",
        "A1",
        "A2",
        "A3",
        "A4"
      ]
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "granted_by": {
      "type": "string",
      "minLength": 1
    },
    "approval_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
