{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://system-foundry.local/schemas/reproducible-output.schema.json",
  "title":"Reproducible Consequential Output",
  "type":"object",
  "required":["output_id","output_version","generated_at","evidence_cutoff","inputs","policy_versions","execution_refs"],
  "properties":{
    "output_id":{"type":"string","minLength":1},
    "output_version":{"type":"string","minLength":1},
    "generated_at":{"type":"string","format":"date-time"},
    "evidence_cutoff":{"type":"string","format":"date-time"},
    "inputs":{"type":"array","minItems":1,"items":{"type":"string"}},
    "policy_versions":{"type":"array","items":{"type":"string"}},
    "method_versions":{"type":"array","items":{"type":"string"}},
    "model_versions":{"type":"array","items":{"type":"string"}},
    "execution_refs":{"type":"array","minItems":1,"items":{"type":"string"}},
    "unknowns":{"type":"array","items":{"type":"string"}},
    "disagreements":{"type":"array","items":{"type":"string"}}
  }
}
