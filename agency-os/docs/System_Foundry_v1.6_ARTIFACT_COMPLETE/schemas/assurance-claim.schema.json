{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Assurance Claim",
  "type": "object",
  "required": [
    "claim_id",
    "claim",
    "argument",
    "evidence",
    "status"
  ],
  "properties": {
    "claim_id": {
      "type": "string"
    },
    "claim": {
      "type": "string"
    },
    "argument": {
      "type": "string"
    },
    "evidence": {
      "type": "array"
    },
    "status": {
      "enum": [
        "UNPROVEN",
        "PARTIALLY_SUPPORTED",
        "SUPPORTED",
        "REJECTED"
      ]
    }
  }
}
