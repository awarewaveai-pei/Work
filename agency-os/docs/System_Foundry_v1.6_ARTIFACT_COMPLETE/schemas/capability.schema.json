{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Foundry Capability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "module",
    "requires",
    "description"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "module": {
      "type": [
        "string",
        "null"
      ]
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "description": {
      "type": "string"
    }
  }
}
