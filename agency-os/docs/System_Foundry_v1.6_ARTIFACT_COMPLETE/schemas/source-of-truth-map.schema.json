{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://system-foundry.local/schemas/source-of-truth-map.schema.json",
  "title": "Source Of Truth Map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domains"
  ],
  "properties": {
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "owner",
          "authoritative_path"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "authoritative_path": {
            "type": "string",
            "minLength": 1
          },
          "derived_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
