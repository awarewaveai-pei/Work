{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Foundry Module Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["module_id", "owner", "state_ownership", "behavior_ownership", "public_contracts", "invariants", "dependencies", "failure_boundary", "observability", "migration", "rollback", "replacement_strategy"],
  "properties": {
    "module_id": {"type": "string"},
    "owner": {"type": "string"},
    "state_ownership": {"type": "array", "items": {"type": "string"}},
    "behavior_ownership": {"type": "array", "items": {"type": "string"}},
    "public_contracts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "invariants": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "failure_boundary": {"type": "string"},
    "observability": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "migration": {"type": "string"},
    "rollback": {"type": "string"},
    "replacement_strategy": {"type": "string", "minLength": 1}
  }
}
