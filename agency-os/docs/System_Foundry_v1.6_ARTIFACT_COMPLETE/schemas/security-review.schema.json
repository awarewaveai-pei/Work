{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://system-foundry.local/schemas/security-review.schema.json",
  "title": "Security Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "threat_model",
    "trust_boundaries",
    "authn_authz",
    "secrets",
    "crypto",
    "supply_chain",
    "security_tests",
    "residual_risk"
  ],
  "properties": {
    "threat_model": {
      "type": "string",
      "minLength": 1
    },
    "trust_boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "authn_authz": {
      "type": "string",
      "minLength": 1
    },
    "secrets": {
      "type": "string",
      "minLength": 1
    },
    "crypto": {
      "type": "string",
      "minLength": 1
    },
    "supply_chain": {
      "type": "string",
      "minLength": 1
    },
    "security_tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "residual_risk": {
      "type": "string",
      "minLength": 1
    }
  }
}
