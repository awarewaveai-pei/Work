{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://system-foundry.local/schemas/migration-plan.schema.json",
  "title": "Migration Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scope",
    "preconditions",
    "steps",
    "verification",
    "rollback",
    "data_compatibility"
  ],
  "properties": {
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "preconditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "rollback": {
      "type": "string",
      "minLength": 1
    },
    "data_compatibility": {
      "type": "string",
      "minLength": 1
    }
  }
}
