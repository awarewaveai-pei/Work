{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://system-foundry.local/schemas/release-evidence.schema.json",
  "title": "Release Evidence Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "source_revision",
    "artifact_digest",
    "risk_tier",
    "change_set_ref",
    "test_evidence",
    "rollback",
    "rollback_thresholds",
    "observability",
    "approvals",
    "deployment_strategy",
    "sbom_digest",
    "provenance_digest",
    "release_notes_ref",
    "post_release_checks"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "type": "string",
      "minLength": 7
    },
    "artifact_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "risk_tier": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4"
      ]
    },
    "change_set_ref": {
      "type": "string",
      "minLength": 1
    },
    "test_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "rollback": {
      "type": "string",
      "minLength": 5
    },
    "rollback_thresholds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "observability": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deployment_strategy": {
      "enum": [
        "DIRECT",
        "ROLLING",
        "BLUE_GREEN",
        "CANARY",
        "RING",
        "SHADOW"
      ]
    },
    "sbom_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "provenance_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "migration_evidence": {
      "type": [
        "string",
        "null"
      ]
    },
    "release_notes_ref": {
      "type": "string",
      "minLength": 1
    },
    "post_release_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "risk_tier": {
            "enum": [
              "R3",
              "R4"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "approvals": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "risk_tier": {
            "const": "R4"
          }
        }
      },
      "then": {
        "properties": {
          "approvals": {
            "minItems": 2
          }
        }
      }
    }
  ]
}
