{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Foundry Task",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "purpose", "why", "current_state", "target_state", "exact_paths", "dependencies", "data_impact", "security_impact", "migration", "implementation", "tests", "observability", "rollback", "acceptance_criteria", "expected_result"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "why": {"type": "string", "minLength": 1},
    "current_state": {"type": "string", "minLength": 1},
    "target_state": {"type": "string", "minLength": 1},
    "exact_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "data_impact": {"type": "string"},
    "security_impact": {"type": "string"},
    "migration": {"type": "string", "minLength": 1},
    "implementation": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "tests": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "observability": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "rollback": {"type": "string", "minLength": 1},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "expected_result": {"type": "string", "minLength": 1}
  }
}
