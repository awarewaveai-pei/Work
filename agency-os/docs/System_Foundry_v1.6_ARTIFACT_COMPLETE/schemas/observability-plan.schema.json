{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://system-foundry.local/schemas/observability-plan.schema.json",
  "title": "Observability Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "signals",
    "dashboards",
    "alerts",
    "correlation",
    "retention",
    "privacy"
  ],
  "properties": {
    "signals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "dashboards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "alerts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "correlation": {
      "type": "string",
      "minLength": 1
    },
    "retention": {
      "type": "string",
      "minLength": 1
    },
    "privacy": {
      "type": "string",
      "minLength": 1
    }
  }
}
