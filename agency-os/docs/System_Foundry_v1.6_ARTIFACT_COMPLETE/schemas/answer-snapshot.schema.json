{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Foundry Answer Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "questionnaire_version",
    "questionnaire_digest",
    "project",
    "answers",
    "custom_requirements"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "questionnaire_version": {
      "type": "string"
    },
    "questionnaire_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "answers": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "custom_requirements": {
      "type": "array",
      "items": {
        "$ref": "custom-requirement.schema.json"
      }
    }
  }
}
