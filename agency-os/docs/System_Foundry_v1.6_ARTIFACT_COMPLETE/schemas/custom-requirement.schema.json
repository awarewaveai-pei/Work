{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Custom Requirement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "category",
    "statement"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^REQ-CUSTOM-[0-9]{5}$"
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 3,
      "maxLength": 2000
    },
    "source": {
      "const": "USER_CUSTOM"
    }
  }
}
