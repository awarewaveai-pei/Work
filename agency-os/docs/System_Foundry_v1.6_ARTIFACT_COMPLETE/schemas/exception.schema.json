{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://system-foundry.local/schemas/exception.schema.json",
  "title": "Controlled Exception",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "violated_rule",
    "rationale",
    "risk_tier",
    "scope",
    "owner",
    "approver",
    "starts_at",
    "expires_at",
    "compensating_controls",
    "monitoring",
    "evidence",
    "removal_task",
    "permanent_target_fix",
    "rollback"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "violated_rule": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 10
    },
    "risk_tier": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4"
      ]
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "approver": {
      "type": "string",
      "minLength": 1
    },
    "starts_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "compensating_controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "monitoring": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "removal_task": {
      "type": "string",
      "minLength": 1
    },
    "permanent_target_fix": {
      "type": "string",
      "minLength": 1
    },
    "rollback": {
      "type": "string",
      "minLength": 5
    }
  }
}
