+#[derive(Clone, Copy, Default)]
+struct AppChoice(Brightness, Accent, Scheme);
+
+/// A host-supplied token set (web embedders: `window.vectorcraft.setTheme`). While set, the
+/// app's own [`apply_with`] calls keep using it instead of the chosen brightness.
+#[derive(Clone, Copy)]
+struct HostTokens(Tokens);
+
+/// Set or clear the host token override and apply the outcome at once: `Some(t)` applies `t`
+/// and keeps it across the app's own theme re-applies; `None` restores the app's own choice.
+/// The override lives in the egui context's data, so a graphics restart (a new context) drops
+/// it and the host sets it again.
+pub fn set_host_tokens(ctx: &egui::Context, t: Option<Tokens>) {
+    match t {
+        Some(t) => {
+            ctx.data_mut(|d| d.insert_temp(egui::Id::NULL, HostTokens(t)));
+            apply_tokens(ctx, t);
+        }
+        None => {
+            ctx.data_mut(|d| d.remove::<HostTokens>(egui::Id::NULL));
+            let AppChoice(b, accent, scheme) = ctx.data(|d| d.get_temp(egui::Id::NULL)).unwrap_or_default();
+            apply_with(ctx, b, accent, scheme);
+        }
+    }
+}
