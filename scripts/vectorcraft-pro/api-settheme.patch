+/// `setTheme`'s work: `null` clears the host override (the app's own theme returns); an object
+/// builds a token set — a light or dark base by the panel colour's brightness, each given field
+/// overriding it — and sets it as the host override (`theme::set_host_tokens`), which the app's
+/// own theme re-applies keep. Returns the fields applied; unknown names or bad values reject,
+/// all listed at once.
+fn set_theme(spec: &JsValue) -> Result<Vec<String>, String> {
+    let ctx = CTX.with(|c| c.borrow().clone()).ok_or("VectorCraft is not running yet")?;
+    if spec.is_null() || spec.is_undefined() {
+        theme::set_host_tokens(&ctx, None);
+        return Ok(Vec::new());
+    }
+    let Value::Object(map) = from_js(spec) else {
+        return Err("setTheme: expected an object of token fields, or null to restore".into());
+    };
+    // The base palette for the fields not given: light or dark by the panel colour's brightness,
+    // or the current theme's side when no panel colour is given.
+    let dark_now = ctx.data(|d| d.get_temp::<theme::Tokens>(egui::Id::NULL)).is_none_or(|t| t.dark);
+    let light = match map.get("panel").map(parse_color) {
+        Some(Ok(p)) => luma(p) >= 128.0,
+        _ => !dark_now,
+    };
+    let mut t = theme::Tokens::for_brightness(if light { theme::Brightness::Light } else { theme::Brightness::Dark });
+    let (mut applied, mut errors) = (Vec::new(), Vec::new());
+    for (k, v) in &map {
+        match set_token_field(&mut t, k, v) {
+            Ok(()) => applied.push(k.clone()),
+            Err(e) => errors.push(format!("{k}: {e}")),
+        }
+    }
+    if !errors.is_empty() {
+        return Err(format!("setTheme: {}", errors.join("; ")));
+    }
+    theme::set_host_tokens(&ctx, Some(t));
+    Ok(applied)
+}
+
+/// Set one named `Tokens` field from its JSON value: colours are `"#rrggbb"`, `radius` is 0-255.
+fn set_token_field(t: &mut theme::Tokens, key: &str, v: &Value) -> Result<(), String> {
+    macro_rules! colours {
+        ($($f:ident),* $(,)?) => {
+            match key {
+                $(stringify!($f) => t.$f = parse_color(v)?,)*
+                "radius" => t.radius = v.as_u64().filter(|n| *n <= 255).ok_or_else(|| "expected a number 0-255".to_string())? as u8,
+                _ => return Err("unknown field".into()),
+            }
+        };
+    }
+    colours!(
+        app_bar, panel, panel_darker, input, input_border, border, divider, text, text_dim,
+        text_disabled, icon, hover, tool_active, accent, accent_strong, row_selected, pasteboard,
+        ruler, ruler_tick, smart_guide, guide, measure_bg, button, text_strong, tab_strip,
+        button_border, selection, anchor_selected, flyout_active, caption_close, caption_close_text,
+        highlight, bleed, artboard_mark, error, warning, axis_x, axis_y, axis_z,
+    );
+    Ok(())
+}
+
+/// A CSS `#rrggbb` colour.
+fn parse_color(v: &Value) -> Result<egui::Color32, String> {
+    let bad = || "expected \"#rrggbb\"".to_string();
+    let hex = v.as_str().and_then(|s| s.strip_prefix('#')).ok_or_else(bad)?;
+    if hex.len() != 6 || !hex.bytes().all(|b| b.is_ascii_hexdigit()) {
+        return Err(bad());
+    }
+    let n = u32::from_str_radix(hex, 16).map_err(|_| bad())?;
+    Ok(egui::Color32::from_rgb((n >> 16) as u8, (n >> 8) as u8, n as u8))
+}
+
+/// Perceived brightness 0-255 (Rec. 601 luma).
+fn luma(c: egui::Color32) -> f32 {
+    0.299 * f32::from(c.r()) + 0.587 * f32::from(c.g()) + 0.114 * f32::from(c.b())
+}
