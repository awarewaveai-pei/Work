diff --git a/apps/effectcraft-web/src/host.rs b/apps/effectcraft-web/src/host.rs
new file mode 100755
index 00000000..e9e6b527
--- /dev/null
+++ b/apps/effectcraft-web/src/host.rs
@@ -0,0 +1,130 @@
+//! Host mode: a same-origin page framing EffectCraft with `?host=parent` (or running it in its own
+//! document with `data-host="page"` on the canvas) opens files in it and takes what it writes
+//! instead of the browser downloading. The messages and both transports are `craft-web-host`'s
+//! (storytold/craft-libs), the contract the other Craft web builds speak, with the `effectcraft:`
+//! prefix. Unframed, or framed by another origin, there is no bridge: the normal app with downloads.
+//!
+//! - `effectcraft:ready` once the app runs and listens (`file: false`: send `bytes`).
+//! - `effectcraft:open` `{ name, bytes }`: a `.ecproj` opens like File › Open, anything else
+//!   imports like a file dropped on the page. Over [`MAX_OPEN_BYTES`]: refused in the status bar.
+//! - `effectcraft:save` `{ name, saveAs, bytes }`: every file the app would otherwise download —
+//!   project saves, written files, Render Queue outputs (several as one `.zip`, as downloaded).
+//!   `saveAs: true` when the file becomes the document's file — the session adopted it as its
+//!   project path and the host doesn't already have it as the document (Save As; the first Save of
+//!   a project the host never sent). `false` for a Save under the document's own name and for
+//!   every copy (Save a Copy, renders).
+//! - `effectcraft:dirty` when unsaved changes appear or go away; `effectcraft:failed` when the app
+//!   can't start.
+//!
+//! In host mode the host sends the document to edit: no demo, no restored session, no recovery offer.
+
+use std::cell::RefCell;
+use std::rc::Rc;
+
+use craft_web_host::web::{FileData, Host, Message};
+
+const APP: &str = "effectcraft";
+
+/// The largest `effectcraft:open` payload, refused before any byte is copied (the Craft family's default).
+pub const MAX_OPEN_BYTES: f64 = (512u64 << 20) as f64;
+
+struct Bridge {
+    host: Rc<Host>,
+    /// The document file the host has: the project it opened here, and every file sent with `saveAs: true`.
+    document: Option<String>,
+}
+
+thread_local! {
+    static BRIDGE: RefCell<Option<Bridge>> = const { RefCell::new(None) };
+}
+
+/// Connect to the hosting page, if any, and hear its files. Returns whether the app is hosted.
+pub fn connect(canvas: &web_sys::Element) -> bool {
+    let Some(host) = Host::connect(APP, canvas).map(Rc::new) else { return false };
+    let reply_to = host.clone();
+    host.listen(move |message| {
+        if let Message::Open { name, data } = message {
+            open(&reply_to, name, data);
+        }
+    });
+    BRIDGE.with(|b| *b.borrow_mut() = Some(Bridge { host, document: None }));
+    true
+}
+
+pub fn is_hosted() -> bool {
+    BRIDGE.with(|b| b.borrow().is_some())
+}
+
+fn host() -> Option<Rc<Host>> {
+    BRIDGE.with(|b| b.borrow().as_ref().map(|b| b.host.clone()))
+}
+
+pub fn post_ready() {
+    if let Some(h) = host()
+        && let Err(e) = h.post_ready(env!("CARGO_PKG_VERSION"), false)
+    {
+        log::error!("couldn't tell the host EffectCraft is ready: {e}");
+    }
+}
+
+pub fn post_failed(error: &str) {
+    if let Some(h) = host() {
+        let _ = h.post_failed(error, None);
+    }
+}
+
+pub fn post_dirty(dirty: bool) {
+    if let Some(h) = host() {
+        h.post_dirty(dirty);
+    }
+}
+
+/// Hand a written file to the host. `project` = the session's project path after the frame's
+/// commands (a Save As adopts its path only after the write), for the `saveAs` rule.
+pub fn save(path: &str, name: &str, bytes: &[u8], project: Option<&str>) {
+    let Some(h) = host() else { return };
+    let before = BRIDGE.with(|b| b.borrow().as_ref().and_then(|b| b.document.clone()));
+    let save_as = before.as_deref() != Some(path) && project == Some(path);
+    match h.post_save(name, bytes, None, save_as) {
+        Ok(()) if save_as => set_document(path),
+        Ok(()) => {}
+        Err(e) => log::error!("couldn't hand {name} to the host: {e}"),
+    }
+}
+
+fn set_document(path: &str) {
+    BRIDGE.with(|b| {
+        if let Some(b) = b.borrow_mut().as_mut() {
+            b.document = Some(path.to_string());
+        }
+    });
+}
+
+/// A host's file: into the file table, then opened or imported like a dropped file.
+fn open(host: &Rc<Host>, name: String, data: FileData) {
+    if data.size() > MAX_OPEN_BYTES {
+        let why = format!("{name}: over the {} MiB host open limit", (MAX_OPEN_BYTES as u64) >> 20);
+        let _ = host.post_failed(&why, None);
+        return crate::post(move |app| app.ui.status = why);
+    }
+    let host = host.clone();
+    wasm_bindgen_futures::spawn_local(async move {
+        let bytes = match data {
+            FileData::Bytes(array) => Ok(array.to_vec()),
+            FileData::Blob(blob) => wasm_bindgen_futures::JsFuture::from(blob.array_buffer()).await.map(|b| js_sys::Uint8Array::new(&b).to_vec()),
+        };
+        let Ok(bytes) = bytes else {
+            let _ = host.post_failed(&format!("couldn't read {name}"), None);
+            return;
+        };
+        let path = crate::files::path_for(&name);
+        crate::files::put(&path, bytes.into());
+        crate::post(move |app| {
+            crate::open_or_import(app, vec![path.clone()]);
+            // The host's project opened: a Save of it goes out under its own name (`saveAs: false`).
+            if app.session.path.as_deref() == Some(path.as_str()) {
+                set_document(&path);
+            }
+        });
+    });
+}
