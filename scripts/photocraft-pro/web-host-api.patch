+/// A file the hosting page sends (`photocraft:open`) opens as File › Open would, through the same
+/// inbox as a dropped file.
+fn listen_host(host: Rc<Host>, inbox: Inbox, ctx: egui::Context) {
+    let reply_to = host.clone();
+    host.listen(move |message| {
+        let Message::Open { name, data } = message else { return };
+        let (host, inbox, ctx) = (reply_to.clone(), inbox.clone(), ctx.clone());
+        wasm_bindgen_futures::spawn_local(async move {
+            let bytes = match data {
+                FileData::Bytes(array) => Ok(array.to_vec()),
+                FileData::Blob(blob) => wasm_bindgen_futures::JsFuture::from(blob.array_buffer()).await.map(|b| js_sys::Uint8Array::new(&b).to_vec()),
+            };
+            match bytes {
+                Ok(bytes) => {
+                    inbox.lock().unwrap_or_else(PoisonError::into_inner).push((name, bytes));
+                    ctx.request_repaint();
+                }
+                Err(e) => {
+                    log::error!("couldn't read {name} from the host: {e:?}");
+                    let _ = host.post_failed(&format!("couldn't read {name}"), None);
+                }
+            }
+        });
+    });
+}
