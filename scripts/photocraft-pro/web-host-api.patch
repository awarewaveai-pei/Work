+    /// After each frame: settle the `window.photocraft` requests the app answered (replies are
+    /// read only between frames, so keep drawing while any wait) and report the unsaved state.
+    fn after_frame(&self, ctx: &egui::Context) {
+        let mut waiting = self.waiting.borrow_mut();
+        waiting.retain(|(reply, resolve)| {
+            let answer = match reply.try_recv() {
+                Ok(answer) => answer,
+                Err(std::sync::mpsc::TryRecvError::Empty) => return true,
+                Err(std::sync::mpsc::TryRecvError::Disconnected) => serde_json::json!({"ok": false, "error": "the request was dropped"}),
+            };
+            let _ = resolve.call1(&wasm_bindgen::JsValue::NULL, &wasm_bindgen::JsValue::from_str(&answer.to_string()));
+            false
+        });
+        if !waiting.is_empty() {
+            ctx.request_repaint();
+        }
+        if let Some(host) = &self.host {
+            host.post_dirty(self.app.has_unsaved_work());
+        }
+    }
