+/// `window.photocraft` (craft-web-api): each request goes into the app's control channel, the one
+/// the desktop control server feeds, and settles once the app answers it.
+fn install_page_api(control: std::sync::mpsc::Sender<photocraft_ui_egui::ControlRequest>, waiting: Waiting, ctx: egui::Context) {
+    use craft_web_api::methods::Methods;
+    use craft_web_api::page::{PageApi, Request};
+    // The desktop transport's deadline (`control::REPLY_DEADLINE`). Past it the request is given up
+    // through its `Dispatch`, as the TCP transport does: a request still queued then never runs
+    // (a hidden tab draws no frames), so re-sending it can't apply an edit twice (#3662).
+    let deadline_ms = i32::try_from(photocraft_ui_egui::control::REPLY_DEADLINE.as_millis()).unwrap_or(i32::MAX);
+    let request: Request = Rc::new(move |method: String, params: serde_json::Value| {
+        let (request, reply) = photocraft_ui_egui::ControlRequest::new(method, params);
+        let dispatch = request.dispatch.clone();
+        // A request the app never takes drops its reply sender: `after_frame` reports that.
+        let _ = control.send(request);
+        let mut reply = Some(reply);
+        let answered = js_sys::Promise::new(&mut |resolve, _reject| {
+            if let Some(reply) = reply.take() {
+                waiting.borrow_mut().push((reply, resolve));
+            }
+        });
+        let expired = js_sys::Promise::new(&mut |resolve, _reject| {
+            if let Some(window) = web_sys::window() {
+                let _ = window.set_timeout_with_callback_and_timeout_and_arguments_0(&resolve, deadline_ms);
+            }
+        });
+        ctx.request_repaint(); // requests are taken between frames
+        Box::pin(async move {
+            let first = js_sys::Promise::race(&js_sys::Array::of2(&answered, &expired));
+            // The reply is JSON text; the deadline resolves with `undefined`.
+            match wasm_bindgen_futures::JsFuture::from(first).await.ok().and_then(|v| v.as_string()) {
+                Some(text) => serde_json::from_str(&text).unwrap_or_else(|_| serde_json::json!({"ok": false, "error": "unreadable reply"})),
+                None => serde_json::json!({"ok": false, "error": dispatch.give_up()}),
+            }
+        })
+    });
+    // The page's own timeout only backs this deadline up.
+    let timeout_ms = u32::try_from(deadline_ms).unwrap_or(u32::MAX).saturating_add(5_000);
+    // `document.inspect` is an engine command here, not a control method: reach it with
+    // `execute("document.inspect", {})`, so no `docInspect` that could only fail.
+    let methods = Methods { doc_inspect: None, ..Methods::default() };
+    if let Err(e) = Rc::new(PageApi::new("photocraft", methods, request).with_timeout(timeout_ms)).install() {
+        log::error!("photocraft-web: couldn't install window.photocraft: {e:?}");
+    }
+}
