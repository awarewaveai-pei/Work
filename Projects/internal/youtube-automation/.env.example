# 複製本檔為 .env 後填值。.env 已被 .gitignore 排除，不會進版控。
# 禁止把真實金鑰提交到 git。

# ─── AI：腳本與圖片 ───
CLAUDE_API_KEY=sk-ant-xxxx
CLAUDE_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=sk-xxxx              # DALL-E 3 圖片生成
IMAGE_MODEL=dall-e-3
IMAGE_SIZE=1792x1024

# ─── WordPress ───
WP_ENABLE=true                      # false = 只做影片不發 WP
WP_URL=https://your-site.com
WP_USERNAME=your-wp-user
WP_PASSWORD=xxxx xxxx xxxx xxxx     # WordPress 應用程式密碼（非登入密碼）
WP_STATUS=publish                   # publish / draft

# ─── YouTube ───
YOUTUBE_ENABLE=true                 # false = 不上傳 YouTube
YOUTUBE_CLIENT_SECRETS=client_secrets.json
YOUTUBE_TOKEN_FILE=youtube_token.json
YOUTUBE_PRIVACY=public              # public / unlisted / private（測試期建議 private）

# ─── 影片設定 ───
BASE_WIDTH=1920
BASE_HEIGHT=1080
FPS=24
TTS_VOICE=zh-TW-HsiaoChenNeural

# 輸出 / 暫存目錄（排程時建議填絕對路徑）
# OUTPUT_DIR=/opt/youtube-automation/output
# TEMP_DIR=/opt/youtube-automation/temp

# ─── Supabase 主題佇列（controller 用）───
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=xxxx                   # anon key
SUPABASE_TABLE=topics
MAX_TOPICS_PER_RUN=3

# ─── Telegram 通知（controller 用，選用）───
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ─── 自動抓熱門議題（全部選用，留空即關閉）───
ENABLE_GOOGLE_TRENDS=false
TRENDS_GEO=taiwan

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=autopublish/1.0
REDDIT_SUBREDDITS=                  # 逗號分隔，例：taiwan,investing

YOUTUBE_API_KEY=
YOUTUBE_SEARCH_QUERIES=             # 逗號分隔，例：台灣科技新聞,AI教學

NEWS_API_KEY=
NEWS_QUERIES=                       # 逗號分隔，例：人工智慧,台灣股市
NEWS_LANGUAGE=zh
