{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/[lang]/layout,_N_T_/[lang]/tarot/layout,_N_T_/[lang]/tarot/page,_N_T_/zh-TW/tarot"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/$d$lang/tarot/__PAGE__",
    "/$d$lang/tarot",
    "/$d$lang",
    "/_index",
    "/_head"
  ]
}