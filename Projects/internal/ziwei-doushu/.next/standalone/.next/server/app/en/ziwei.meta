{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/[lang]/layout,_N_T_/[lang]/ziwei/layout,_N_T_/[lang]/ziwei/page,_N_T_/en/ziwei"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/$d$lang/ziwei/__PAGE__",
    "/$d$lang/ziwei",
    "/$d$lang",
    "/_index",
    "/_head"
  ]
}