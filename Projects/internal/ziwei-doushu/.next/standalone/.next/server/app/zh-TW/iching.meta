{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/[lang]/layout,_N_T_/[lang]/iching/layout,_N_T_/[lang]/iching/page,_N_T_/zh-TW/iching"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/$d$lang/iching/__PAGE__",
    "/$d$lang/iching",
    "/$d$lang",
    "/_index",
    "/_head"
  ]
}