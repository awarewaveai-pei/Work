{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/[lang]/layout,_N_T_/[lang]/bazi/layout,_N_T_/[lang]/bazi/page,_N_T_/en/bazi"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/$d$lang/bazi/__PAGE__",
    "/$d$lang/bazi",
    "/$d$lang",
    "/_index",
    "/_head"
  ]
}