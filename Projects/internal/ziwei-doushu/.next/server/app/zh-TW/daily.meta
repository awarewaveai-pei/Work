{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/[lang]/layout,_N_T_/[lang]/daily/layout,_N_T_/[lang]/daily/page,_N_T_/zh-TW/daily"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/$d$lang/daily/__PAGE__",
    "/$d$lang/daily",
    "/$d$lang",
    "/_index",
    "/_head"
  ]
}