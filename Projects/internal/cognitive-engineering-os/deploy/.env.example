# Copy to deploy/.env on the host (gitignored). Loaded by docker-compose.yml env_file.
# Storage (docs/platform/STORAGE_SWITCH.md, GO_LIVE.md): one line, REQUIRED -- the engine refuses to run without it. It carries
# the database password, so it exists in deploy/.env only; ops/cognitive-db/install-cognitive-db.sh appends it from the password
# file, you never type the password. Shape (region = lowercase letters, digits, '-'; deploy.sh reads it for the files volume
# cognitive-os-files-<region>):
# COGNITIVE_OS_DATABASE_URLS=<region>=postgresql://cognitive:<password>@cognitive-db:5432/cognitive_os
# AI gateway (ai_lego/platform/ai_gateway). Without the key, /ai/* answers 503 AI_PROVIDER_UNCONFIGURED.
COGNITIVE_OS_ANTHROPIC_API_KEY=
# Optional override; default claude-opus-5-5 (ai_lego/platform/ai_gateway/provider.py DEFAULT_MODEL).
COGNITIVE_OS_AI_MODEL=
# Optional per-tenant daily token ceiling (input+output) = the whole space's cost brake, all people together; default 200000
# (ai_lego/platform/ai_gateway/provider.py DEFAULT_DAILY_TOKEN_BUDGET). Exceeded -> 429 AI_DAILY_TOKEN_BUDGET_EXCEEDED
# (message: scope=tenant). Must be a positive integer. For a class or workshop raise it to about (people x per-person share).
COGNITIVE_OS_AI_DAILY_TOKEN_BUDGET=
# Optional per-person daily token share (input+output), checked beside the ceiling above in the same reservation; default 100000
# (DEFAULT_PERSON_TOKEN_BUDGET). Exceeded -> 429 AI_DAILY_TOKEN_BUDGET_EXCEEDED (message: scope=person). Positive integer;
# a bad value of either number answers 503, never unlimited.
COGNITIVE_OS_AI_DAILY_TOKEN_BUDGET_PER_PERSON=
# Entitlements (ADR 017 §4; ai_lego/platform/entitlement/check.py). Unset ENTITLEMENT_MODE = shadow: every check is computed and
# logged (entitlement.would_deny / entitlement.infra_error) but allowed. Only the exact word enforce refuses -- flipping it is High
# (operator go) and needs the issuer token, the keys and every tenant mapped first.
ENTITLEMENT_MODE=
# kid:PEM;kid2:PEM -- the same public keys as next-admin (
 escapes allowed).
ENTITLEMENT_PUBLIC_KEYS=
# tenant_id=organization_id;... -- each tenant's next-admin billing account (root organization id).
ENTITLEMENT_BILLING_ACCOUNTS=
# Permit issuer (next-admin POST /api/internal/entitlements/permit/cognitive), asked when a request carries no
# X-AwareWave-Permit. The token = next-admin's ENTITLEMENT_ISSUER_TOKEN_COGNITIVE; the host must be in the egress allowlist.
ENTITLEMENT_ISSUER_URL=https://app.aware-wave.com
ENTITLEMENT_ISSUER_TOKEN=
# Research collection runs: bearer for COS -> next-admin /api/internal/collect/runs and for next-admin -> COS grant
# exchange; the SAME value as next-admin's COLLECT_RESEARCH_RUNS_TOKEN. Empty -> /projects/{id}/collections answers 503.
COLLECT_RESEARCH_RUNS_TOKEN=
# Recipe run journal encryption (ai_lego/platform/workflow/journal_protection.py). disabled (default) = a run whose
# Project is Confidential/Restricted answers 503 WORKFLOW_JOURNAL_PROTECTION_REQUIRED; local-dev = every run's journal
# is encrypted with the key below. KEY = 32 random bytes, base64. LOSING IT = encrypted journals can never be read
# back: vault it (scripts/secrets-vault.ps1, name COGNITIVE_OS_JOURNAL_KEY_B64) BEFORE setting the mode.
COGNITIVE_OS_JOURNAL_KEY_MODE=
COGNITIVE_OS_JOURNAL_KEY_B64=
