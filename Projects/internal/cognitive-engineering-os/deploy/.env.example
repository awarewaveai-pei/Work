# Copy to deploy/.env on the host (gitignored). Loaded by docker-compose.yml env_file.
# AI gateway (ai_lego/platform/ai_gateway). Without the key, /ai/* answers 503 AI_PROVIDER_UNCONFIGURED.
COGNITIVE_OS_ANTHROPIC_API_KEY=
# Optional override; default claude-sonnet-5 (ai_lego/platform/ai_gateway/provider.py DEFAULT_MODEL).
COGNITIVE_OS_AI_MODEL=
# Optional per-tenant daily token ceiling (input+output); default 200000 (ai_lego/platform/ai_gateway/provider.py
# DEFAULT_DAILY_TOKEN_BUDGET). Exceeded -> 429 AI_DAILY_TOKEN_BUDGET_EXCEEDED. Must be a positive integer.
COGNITIVE_OS_AI_DAILY_TOKEN_BUDGET=
# Research collection runs: bearer for COS -> next-admin /api/internal/collect/runs and for next-admin -> COS grant
# exchange; the SAME value as next-admin's COLLECT_RESEARCH_RUNS_TOKEN. Empty -> /projects/{id}/collections answers 503.
COLLECT_RESEARCH_RUNS_TOKEN=
