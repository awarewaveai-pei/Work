# --- Local backup directory (machine-local snapshots; never commit) ---
Backups/

# --- Paid plugin zips (licensed binaries; upload to VPS /opt/lobster-plugins/ via SFTP) ---
_paid-plugins/

# Runtime subdirectories (Claude Code internal state, not project source)
.claude/backups/
.claude/cache/
.claude/debug/
.claude/downloads/
.claude/file-history/
.claude/hooks/
.claude/ide/
.claude/paste-cache/
.claude/plugins/
# memory 不進 git（CLAUDE.md R1）— 可能含敏感資料；跨機同步走 Google Drive vault
# (export-cross-machine-memory.ps1 / import-cross-machine-memory.ps1)，非 git。
# 還原 70fb8e51（2026-06-04 誤把 memory 納入 git，違反 R1，造成 ao-close guard 卡死）。
.claude/projects/
.claude/session-env/
.claude/sessions/
.claude/shell-snapshots/
.claude/skills/*
# All project skill folders + .skill files are tracked (cross-machine sync via git symlink).
# Negate the wildcard ignore for actual skill content; runtime caches stay ignored.
!.claude/skills/*/
!.claude/skills/*.skill
.claude/skills/.cache/
.claude/skills/*/.cache/

.claude/telemetry/
.claude/tasks/
.claude/worktrees/
# Claude Code built-in agent READMEs (auto-generated, no project content)
.claude/agents/README.md
.claude/agents/README.zh-TW.md
# NOTE: Built-in agent .md files (critic, debugger, frontend-designer, etc.) are intentionally
# tracked in git because they have been customized with AwareWave stack context. If Claude Code
# runtime overwrites them on update, restore from git: git checkout HEAD -- .claude/agents/*.md
# .claude/commands/ and ALL .claude/agents/*.md ARE tracked in git

