{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "system-foundry-configurator",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "agency-os/docs/System_Foundry_v1.6_ARTIFACT_COMPLETE/scripts/serve_configurator.py",
        "--host",
        "127.0.0.1",
        "--port",
        "8765",
        "--output-root",
        "agency-os/docs/System_Foundry_v1.6_ARTIFACT_COMPLETE/generated"
      ],
      "port": 8765
    },
    {
      "name": "hci30-app",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "Projects/internal/hci30/app",
        "start"
      ],
      "port": 4030
    },
    {
      "name": "next-admin-verify",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd lobster-factory/infra/hetzner-phase1-core/apps/next-admin && npx next dev -p 3901"
      ],
      "port": 3901
    },
    {
      "name": "next-admin-collect-verify",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd lobster-factory/infra/hetzner-phase1-core/apps/next-admin && npx next dev -p 3902"
      ],
      "port": 3902
    },
    {
      "name": "cognitive-api-dev",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "& './scripts/secrets-vault.ps1' -Action run -Names @('ANTHROPIC_API_KEY') -Command \"& './Projects/internal/cognitive-engineering-os/scripts/dev/launch_cos_dev.ps1'\""
      ],
      "port": 8420
    },
    {
      "name": "cognitive-web-dev",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd Projects/internal/cognitive-engineering-os/apps/cognitive-web && npx next dev -p 3930"
      ],
      "port": 3930
    },
    {
      "name": "social-mocks",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "lobster-factory/docs/social/mockups/preview-server.py",
        "8766"
      ],
      "port": 8766
    },
    {
      "name": "next-admin-social-ui",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "lobster-factory/infra/hetzner-phase1-core/tests/e2e/social/dev-server-no-supabase.mjs",
        "3902"
      ],
      "port": 3902
    }
