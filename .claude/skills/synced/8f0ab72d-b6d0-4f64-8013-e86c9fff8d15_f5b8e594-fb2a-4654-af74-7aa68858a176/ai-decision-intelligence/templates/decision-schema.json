{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Decision Document",
  "description": "Structured output of an AI Decision Intelligence System run",
  "type": "object",
  "required": [
    "metadata",
    "topic",
    "context",
    "candidates",
    "judge_decision",
    "installation_plan",
    "rollout_plan",
    "risk_register"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["generated_at", "mode", "pipeline_stages_completed"],
      "properties": {
        "generated_at": { "type": "string", "format": "date-time" },
        "mode": {
          "type": "string",
          "enum": ["tool_selection", "architecture_review", "implementation"]
        },
        "pipeline_stages_completed": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 16 }
        },
        "specialists_added": {
          "type": "array",
          "items": { "type": "string" }
        },
        "confidence_basis_text": { "type": "string" },
        "recency_bias_check_passed": { "type": "boolean" }
      }
    },
    "topic": {
      "type": "object",
      "required": ["primary_decision", "topic_type", "decision_dimensions"],
      "properties": {
        "primary_decision": { "type": "string" },
        "topic_type": {
          "type": "string",
          "enum": ["tool_selection", "architecture_review", "implementation", "hybrid"]
        },
        "decision_dimensions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "complexity_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "implicit_assumptions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "context": {
      "type": "object",
      "properties": {
        "scale_profile": { "type": "string" },
        "team_profile": {
          "type": "object",
          "properties": {
            "size": { "type": "string" },
            "wp_expertise": { "type": "string" },
            "devops_expertise": { "type": "string" }
          }
        },
        "must_have": {
          "type": "array",
          "items": { "type": "string" }
        },
        "must_not": {
          "type": "array",
          "items": { "type": "string" }
        },
        "budget_band": { "type": "string" },
        "risk_tolerance": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "constraints": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "type", "one_liner"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["saas", "oss_self_host", "build", "hybrid", "devops"]
          },
          "one_liner": { "type": "string" },
          "research_facts": {
            "type": "array",
            "items": { "type": "string" }
          },
          "research_unverified": {
            "type": "array",
            "items": { "type": "string" }
          },
          "advocate_r1": { "type": "object" },
          "advocate_r2": { "type": "object" },
          "reviews": {
            "type": "object",
            "properties": {
              "security": { "type": "object" },
              "devops": { "type": "object" },
              "cost": { "type": "object" },
              "product": { "type": "object" },
              "specialists": {
                "type": "array",
                "items": { "type": "object" }
              }
            }
          },
          "skeptic_findings": { "type": "object" }
        }
      }
    },
    "tradeoff_matrix": {
      "type": "object",
      "properties": {
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "weight": { "type": "number" }
            }
          }
        },
        "scores": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": { "type": "number", "minimum": 1, "maximum": 10 }
          }
        }
      }
    },
    "judge_decision": {
      "type": "object",
      "required": [
        "ranked_candidate_ids",
        "primary",
        "rejections",
        "confidence",
        "switch_conditions"
      ],
      "properties": {
        "ranked_candidate_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "primary": {
          "type": "object",
          "required": ["candidate_id", "reasons", "long_reasoning"],
          "properties": {
            "candidate_id": { "type": "string" },
            "reasons": {
              "type": "array",
              "items": { "type": "string" }
            },
            "long_reasoning": { "type": "string" }
          }
        },
        "rejections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "candidate_id": { "type": "string" },
              "reason": { "type": "string" },
              "could_be_right_if": { "type": "string" }
            }
          }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "confidence_basis": { "type": "string" },
        "switch_conditions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "open_questions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "installation_plan": {
      "type": "object",
      "properties": {
        "phases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "phase_id": { "type": "string" },
              "title": { "type": "string" },
              "duration_days": { "type": "number" },
              "objective": { "type": "string" },
              "tasks": {
                "type": "array",
                "items": { "type": "object" }
              },
              "success_criteria": {
                "type": "array",
                "items": { "type": "string" }
              },
              "rollback_if_phase_fails": { "type": "string" }
            }
          }
        },
        "total_duration_days": { "type": "number" },
        "deliberate_omissions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "rollout_plan": {
      "type": "object",
      "properties": {
        "waves": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "wave_id": { "type": "string" },
              "title": { "type": "string" },
              "scope_quantitative": { "type": "string" },
              "blast_radius": {
                "type": "string",
                "enum": ["low", "medium", "high"]
              },
              "go_no_go_criteria": {
                "type": "array",
                "items": { "type": "string" }
              },
              "rollback_steps": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "global_rollback": { "type": "string" },
        "estimated_total_duration_weeks": { "type": "number" }
      }
    },
    "risk_register": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["risk", "likelihood", "severity", "mitigation"],
        "properties": {
          "risk": { "type": "string" },
          "likelihood": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "severity": {
            "type": "string",
            "enum": ["low", "medium", "high", "catastrophic"]
          },
          "mitigation": { "type": "string" },
          "owner": { "type": "string" }
        }
      }
    }
  }
}
