{
  "name": "wp-basic",
  "version": "1.1.0",
  "schemaVersion": "1.0.0",
  "target": "wordpress",
  "applyMode": "full_install",
  "description": "WordPress container manifest: Kadence theme + operational plugins (MainWP Child, host-conditional cache). User-facing plugin list is owned by agency-os/docs/operations/WP_CLIENT_PLUGIN_STACK.md §八 and installed via wp-install-plugins task — do NOT add user-facing plugins here.",
  "guardrails": {
    "allowEnvironments": ["staging", "production"],
    "requireBackup": false,
    "blockIfProduction": false
  },
  "dependencies": [],
  "conflicts": [],
  "steps": [
    { "id": "theme-kadence",       "type": "install_theme",  "slug": "kadence" },
    { "id": "plugin-mainwp-child", "type": "install_plugin", "slug": "mainwp-child" },
    {
      "id": "plugin-litespeed",
      "type": "conditional_plugin",
      "condition": "is_litespeed",
      "slug": "litespeed-cache"
    }
  ],
  "postInstall": [
    { "type": "activate_theme",   "slug": "kadence" },
    { "type": "flush_permalinks" },
    { "type": "set_option",        "key": "timezone_string", "value": "Asia/Taipei" }
  ],
  "verification": [
    { "type": "check_homepage" },
    { "type": "check_admin_login" },
    { "type": "check_plugin_active", "slug": "mainwp-child" }
  ],
  "smokeProfile": "basic",
  "rollback": {
    "strategy": "restore_backup_snapshot",
    "backup_required_before_apply": false
  }
}
