{
    "name": "awarewave/oracle-wp-plugin",
    "description": "aware-wave-oracle — embeds the AwareWave divination engine in any WordPress site (settings, Ed25519 site key, shortcode, block).",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=7.4",
        "ext-sodium": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "AwareWave\\Oracle\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AwareWave\\Oracle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "lint": "find . -path ./vendor -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l"
    },
    "config": {
        "sort-packages": true
    }
}
