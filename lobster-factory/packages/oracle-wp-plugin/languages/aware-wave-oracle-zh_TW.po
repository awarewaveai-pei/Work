msgid "Tools available from the engine"
msgstr "引擎提供的工具"

#: includes/Admin/SettingsPage.php:273
msgid "None — check the engine URL."
msgstr "沒有工具，請檢查引擎網址。"

#: includes/Admin/SettingsPage.php:274
msgid "Shortcode:"
msgstr "短碼："

#: includes/Admin/SettingsPage.php:276
msgid "Refresh tool list"
msgstr "重新取得工具清單"

#: includes/Admin/SettingsPage.php:412
msgid "Tick the confirmation box to rotate the key."
msgstr "要更換金鑰，請先勾選確認。"

#: includes/Admin/SettingsPage.php:411
msgid "New key created. Register the public key below at the engine."
msgstr "已建立新金鑰。請把下方公鑰登記到引擎。"

#: includes/Admin/SettingsPage.php:415
msgid "Tick the confirmation box to rotate the salt."
msgstr "要更換鹽，請先勾選確認。"

#: includes/Admin/SettingsPage.php:414
msgid "Salt rotated."
msgstr "已更換鹽。"

#: includes/Admin/SettingsPage.php:416
msgid "Tool list refreshed."
msgstr "已重新取得工具清單。"

#: includes/Embed/Block.php:61
msgid "Choose a tool to embed:"
msgstr "選擇要嵌入的工具："

#: includes/Embed/Block.php:62
msgid "Embedded tool:"
msgstr "已嵌入的工具："

#: includes/Embed/Block.php:63
msgid "No tools available — check Settings → AwareWave Oracle."
msgstr "沒有可用的工具，請到「設定 → AwareWave 命理」檢查。"

#: includes/Embed/Block.php:64
msgid "The tool appears here on the published page."
msgstr "頁面發佈後，工具會顯示在這裡。"

