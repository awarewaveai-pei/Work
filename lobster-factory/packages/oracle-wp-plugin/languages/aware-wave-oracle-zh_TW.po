#: includes/Embed/Renderer.php:44
#, php-format
msgid "AwareWave Oracle: %s"
msgstr "AwareWave 命理：%s"

#. Plugin URI of the plugin
#: aware-wave-oracle.php
msgid "https://aware-wave.com"
msgstr "https://aware-wave.com"

#. Description of the plugin
#: aware-wave-oracle.php
msgid "Embeds the AwareWave divination engine (Zi Wei, BaZi, I Ching, Tarot …) in this site's pages with a shortcode or block. Engine address, site key and languages are site settings."
msgstr "用短碼或區塊把 AwareWave 命理引擎（紫微、八字、易經、塔羅…）嵌進本站頁面。引擎網址、站台金鑰與語言都在本站設定。"

#. Author of the plugin
#: aware-wave-oracle.php
msgid "AwareWave"
msgstr "AwareWave"

#: includes/Admin/SettingsPage.php:109
msgid "Key ID: 2–24 characters, lowercase letters, digits and -, starting with a letter or digit."
msgstr "金鑰名稱：2–24 個字元，只能用小寫英文字母、數字和 -，開頭須是字母或數字。"

#: includes/Admin/SettingsPage.php:111
msgid "Default engine language must be zh-TW or en; en was saved."
msgstr "預設引擎語言只能是 zh-TW 或 en；已存成 en。"

#: includes/Admin/SettingsPage.php:115
msgid "Embedding from another domain is not supported yet; same domain was saved."
msgstr "目前還不支援從其他網域嵌入；已存成同網域。"

#. translators: %s: the lines that were not saved
#: includes/Admin/SettingsPage.php:121
#, php-format
msgid "These lines were not saved (wrong format, or a language the engine does not have — zh-TW, en): %s"
msgstr "以下幾行沒有儲存（格式不對，或引擎沒有這個語言——只有 zh-TW、en）：%s"

#. translators: %s: a language slug in TranslatePress settings, e.g. en
#: includes/Admin/SettingsPage.php:137
#, php-format
msgid "TranslatePress language slug /%s/"
msgstr "TranslatePress 語言代稱 /%s/"

#. translators: 1: list of reserved path prefixes, 2: list of pages
#: includes/Admin/SettingsPage.php:144
#, php-format
msgid "These addresses start with a path the engine uses (%1$s) and will not reach WordPress: %2$s"
msgstr "以下網址開頭是引擎使用的路徑（%1$s），到不了 WordPress：%2$s"

#: includes/Admin/SettingsPage.php:217
msgid "Cross-origin only: the address visitors’ browsers load the embedded tools from, e.g. https://engine.example.com"
msgstr "只有跨網域用：訪客的瀏覽器從這個網址載入嵌入的工具，例如 https://engine.example.com"

#: includes/Admin/SettingsPage.php:218
msgid "Address this WordPress server calls the engine at; may be an internal http:// address. Empty: this site’s own address (same-origin) or the browser URL (cross-origin)."
msgstr "本站伺服器呼叫引擎用的網址，可填內部的 http:// 網址。留空：同網域用本站自己的網址，跨網域用瀏覽器用網址。"

#: includes/Admin/SettingsPage.php:220
msgid "zh-TW or en. Used when the page language is neither and has no entry below."
msgstr "zh-TW 或 en。頁面語言兩者都不是、下方也沒有對照時使用。"

#: includes/Admin/SettingsPage.php:221
msgid "Optional, one per line: WordPress locale=engine language, e.g. zh_HK=zh-TW. zh_TW and en_* need no entry."
msgstr "選填，一行一個：WordPress 語系=引擎語言，例如 zh_HK=zh-TW。zh_TW 與 en_* 不用填。"

#: includes/Admin/SettingsPage.php:241
msgid "AWORACLE_SITE_KEYPAIR in wp-config.php is not a valid key."
msgstr "wp-config.php 裡的 AWORACLE_SITE_KEYPAIR 不是有效的金鑰。"

#: includes/Admin/SettingsPage.php:246
#: includes/Admin/SettingsPage.php:413
msgid "The key comes from the AWORACLE_SITE_KEYPAIR constant in wp-config.php; change it there."
msgstr "金鑰來自 wp-config.php 的 AWORACLE_SITE_KEYPAIR 常數，請到那裡修改。"

#: includes/Admin/SettingsPage.php:289
#: includes/Admin/SettingsPage.php:332
msgid "Settings → AwareWave Oracle"
msgstr "設定 → AwareWave 命理"

#: includes/Admin/SettingsPage.php:337
msgid "AwareWave Oracle: members cannot save charts — AWORACLE_DATA_KEY in wp-config.php is not a valid key (base64 of 32 bytes)."
msgstr "AwareWave 命理：會員目前無法存命盤——wp-config.php 裡的 AWORACLE_DATA_KEY 不是有效的金鑰（須為 32 位元組的 base64）。"

#: includes/Admin/SettingsPage.php:338
msgid "AwareWave Oracle: members cannot save charts — AWORACLE_DATA_KEY is not set in wp-config.php."
msgstr "AwareWave 命理：會員目前無法存命盤——wp-config.php 還沒設定 AWORACLE_DATA_KEY。"

#: includes/Admin/SettingsPage.php:346
msgid "Member data"
msgstr "會員資料"

#: includes/Admin/SettingsPage.php:347
msgid "Members can save their own charts and the people they read for ([aw_oracle_my_charts], [aw_oracle_persons]). Names and birth data are encrypted with a key kept in wp-config.php, never in the database, so database backups hold only ciphertext."
msgstr "會員可以存自己的命盤，以及為別人排盤時輸入的對象（[aw_oracle_my_charts]、[aw_oracle_persons]）。名字與出生資料用 wp-config.php 裡的金鑰加密，金鑰不進資料庫，所以資料庫備份裡只有密文。"

#: includes/Admin/SettingsPage.php:349
msgid "Saving is on."
msgstr "存檔功能已開啟。"

#: includes/Admin/SettingsPage.php:349
msgid "Keep a copy of AWORACLE_DATA_KEY outside this server: without it the saved entries cannot be read."
msgstr "請把 AWORACLE_DATA_KEY 另存一份在這台主機以外：少了它，已存的資料就讀不出來。"

#: includes/Admin/SettingsPage.php:353
msgid "Add this line to wp-config.php above “That’s all, stop editing!”, and keep a copy outside this server:"
msgstr "把這一行加進 wp-config.php 的「That’s all, stop editing!」上方，並另存一份在這台主機以外："

#: includes/Admin/SettingsPage.php:437
msgid "Embedding"
msgstr "嵌入方式"

#: includes/Admin/SettingsPage.php:439
msgid "Same domain (recommended): the engine answers under this site’s address at /embed/, /api/, /_next/, /tarot/."
msgstr "同網域（建議）：引擎在本站網址的 /embed/、/api/、/_next/、/tarot/ 下回應。"

#: includes/Admin/SettingsPage.php:441
msgid "Another domain (not supported yet): the engine has its own address; the page and the tool would talk by messages."
msgstr "其他網域（尚未支援）：引擎有自己的網址，頁面與工具之間要靠訊息溝通。"

#: includes/Embed/Renderer.php:39
msgid "AwareWave Oracle: use a valid tool name (and, for cross-origin embedding, set the engine URL in Settings → AwareWave Oracle)."
msgstr "AwareWave 命理：請用有效的工具名稱（跨網域嵌入時，另需到「設定 → AwareWave 命理」填引擎網址）。"

