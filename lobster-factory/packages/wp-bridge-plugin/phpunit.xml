<?xml version="1.0" encoding="UTF-8"?>
<!--
  PHPUnit config for the bridge's WP-free unit suite (Auth spine).
  Run locally with sodium enabled:  php -d extension=sodium vendor/bin/phpunit
  CI loads ext-sodium via the runner image; see infra/github/workflows/wp-bridge-ci.yml (future brick).
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         beStrictAboutOutputDuringTests="true">
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Auth</directory>
            <directory>tests/Content</directory>
            <directory>tests/Http</directory>
            <directory>tests/Transaction</directory>
            <directory>tests/Validation</directory>
        </testsuite>
    </testsuites>
    <coverage>
        <include>
            <directory suffix=".php">includes</directory>
        </include>
    </coverage>
</phpunit>
