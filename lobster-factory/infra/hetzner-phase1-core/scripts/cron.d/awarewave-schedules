# /etc/cron.d/awarewave-schedules -- the jobs root's crontab held until 2026-10-24, plus the schedules inventory.
# Installed by install-host-schedules.sh (do not edit on the host). Times UTC. Each line runs the old command
# unchanged through cron-run.sh, which records the outcome for /ops/schedules.
# reconcile_videos: 06:00 and 18:00 Taipei (was every 15 min; the script retries 3x in-run instead).
# n8n_oom_restart (smart-restart-if-oom.sh) retired 2026-10-24: n8n runs under the compose invariants (mem/pids limits).
# schedules_run_due: the client schedules' clock (lib/schedules); replaces the Trigger.dev hourly heartbeat.
# Every timer that used to be a Trigger.dev schedule rings from here (handoffs/2026-10-25-schedules-off-trigger C1):
# poke.sh <key> <route> <TOKEN_VAR> rings a next-admin route; trigger-task.sh <key> <task> starts a Trigger task and
# waits for its verdict; site-watch-tick.sh is the hourly site-watch round. Frequencies are the old Trigger crons.
# schedule_alerts / schedule_digest: one Telegram+Slack message when a row on /ops/schedules turns red or recovers, and a
# daily 09:00 Taipei line (C4; lib/schedules/alerts.ts) -- if that line does not arrive, the alerting itself is down.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
*/10 * * * * root /root/lobster-phase1/scripts/cron-run.sh host_schedules_report 'python3 /root/lobster-phase1/scripts/report-host-schedules.py >> /var/log/host-schedules.log 2>&1'
0 10,22 * * * root /root/lobster-phase1/scripts/cron-run.sh reconcile_videos '/root/lobster-phase1/scripts/reconcile-videos.sh'
*/30 * * * * root /root/lobster-phase1/scripts/cron-run.sh ops_probe_heartbeat '/root/lobster-phase1/scripts/ops-probe-heartbeat.sh >> /root/lobster-phase1/logs/probe.log 2>&1'
*/5 * * * * root /root/lobster-phase1/scripts/cron-run.sh schedules_run_due '/root/lobster-phase1/scripts/poke.sh schedules_run_due /api/internal/schedules/run-due SCHEDULE_INGEST_TOKEN'
*/5 * * * * root /root/lobster-phase1/scripts/cron-run.sh social_dispatch '/root/lobster-phase1/scripts/poke.sh social_dispatch /api/internal/social/dispatch SOCIAL_DISPATCH_TOKEN'
*/5 * * * * root /root/lobster-phase1/scripts/cron-run.sh cs_inbound_sweep '/root/lobster-phase1/scripts/poke.sh cs_inbound_sweep /api/internal/cs/sweep CS_SWEEP_TOKEN'
*/10 * * * * root /root/lobster-phase1/scripts/cron-run.sh pod_order_inbox_sweep '/root/lobster-phase1/scripts/poke.sh pod_order_inbox_sweep /api/internal/pod-orders/sweep POD_INBOX_SWEEP_TOKEN'
5 0 * * * root /root/lobster-phase1/scripts/cron-run.sh social_rotation '/root/lobster-phase1/scripts/poke.sh social_rotation /api/internal/social/rotation SOCIAL_DISPATCH_TOKEN'
30 19 * * * root /root/lobster-phase1/scripts/cron-run.sh social_metrics '/root/lobster-phase1/scripts/poke.sh social_metrics /api/internal/social/metrics SOCIAL_DISPATCH_TOKEN'
0 1 * * * root /root/lobster-phase1/scripts/cron-run.sh entitlements_expire '/root/lobster-phase1/scripts/poke.sh entitlements_expire /api/internal/entitlements/expire SCHEDULE_INGEST_TOKEN'
5 * * * * root /root/lobster-phase1/scripts/cron-run.sh site_watch_tick '/root/lobster-phase1/scripts/site-watch-tick.sh'
*/10 * * * * root /root/lobster-phase1/scripts/cron-run.sh dispatch_action_run '/root/lobster-phase1/scripts/trigger-task.sh dispatch_action_run dispatch-action-run'
0 4 * * * root /root/lobster-phase1/scripts/cron-run.sh ao_infrastructure_check '/root/lobster-phase1/scripts/trigger-task.sh ao_infrastructure_check ao-infrastructure-check'
*/10 * * * * root /root/lobster-phase1/scripts/cron-run.sh schedule_alerts '/root/lobster-phase1/scripts/poke.sh schedule_alerts /api/internal/schedules/alerts SCHEDULE_INGEST_TOKEN'
0 1 * * * root /root/lobster-phase1/scripts/cron-run.sh schedule_digest '/root/lobster-phase1/scripts/poke.sh schedule_digest /api/internal/schedules/alerts?digest=1 SCHEDULE_INGEST_TOKEN'
*/5 * * * * root /root/lobster-phase1/scripts/cron-run.sh mainwp_wp_cron 'curl -s -o /dev/null http://127.0.0.1:8090/wp-cron.php?doing_wp_cron >/dev/null 2>&1'
0 20 * * * root /root/lobster-phase1/scripts/cron-run.sh deploy_drift_check '/root/lobster-phase1/scripts/check-drift-and-alert.sh >> /var/log/sg-deploy-drift.log 2>&1'
0 3 * * 0 root /root/lobster-phase1/scripts/cron-run.sh supabase_weekly_restart 'cd /root/supabase && docker compose restart studio kong >> /var/log/supabase-weekly-restart.log 2>&1'
0 19 * * * root /root/lobster-phase1/scripts/cron-run.sh auto_deploy_next_admin '/root/lobster-phase1/scripts/auto-deploy-next-admin.sh >> /root/lobster-phase1/logs/auto-deploy.log 2>&1'
11 1 * * * root /root/lobster-phase1/scripts/cron-run.sh backup_status_sync 'LC_ALL=C.UTF-8 bash /root/Work/scripts/sync-backup-status-from-mainwp.sh >> /var/log/backup-status-sync.log 2>&1'
17 7 * * * root /root/lobster-phase1/scripts/cron-run.sh routine_watchdog 'LC_ALL=C.UTF-8 /root/Work/scripts/routine-output-watchdog.sh >> /var/log/routine-watchdog.log 2>&1'
30 2 * * 1 root /root/lobster-phase1/scripts/cron-run.sh certbot_renew '/usr/bin/certbot renew >> /var/log/le-renew.log'
30 3 * * 0 root /root/lobster-phase1/scripts/cron-run.sh docker_weekly_cleanup '/usr/local/bin/docker-weekly-cleanup.sh'
