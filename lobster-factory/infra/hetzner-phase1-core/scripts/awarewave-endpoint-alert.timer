[Unit]
Description=Run AwareWave endpoint alert check every minute (wall-clock aligned)

[Timer]
# Wall-clock every minute at :00 — avoids drift from OnUnitActiveSec=1min where the
# interval becomes (job_duration + 60s). SG checks ~6 URLs (~7s); that drift (~67s)
# exceeds common Kuma push windows (60s) and causes striped DOWN/PENDING history.
OnBootSec=45sec
OnCalendar=*-*-* *:*:00
AccuracySec=1s
Persistent=true
Unit=awarewave-endpoint-alert.service

[Install]
WantedBy=timers.target

