# Copy to .env.renderer-staging on the staging host. Do not commit the copy.
# Use staging-only credentials and a unique staging RENDER_AUTH_TOKEN.
RENDER_AUTH_TOKEN=replace_with_staging_render_token
R2_API_TOKEN=replace_with_staging_r2_token
R2_ACCOUNT_ID=replace_with_staging_r2_account_id
R2_VIDEO_BUCKET=lobster-videos-staging
R2_VIDEO_PUBLIC_BASE=https://staging-media.example.invalid
# The staging R2 egress proxy (docker-compose.renderer-staging.yml) refuses to start without these three.
R2_S3_ENDPOINT=https://replace_with_staging_account_id.r2.cloudflarestorage.com
R2_S3_ACCESS_KEY_ID=replace_with_staging_r2_s3_key_id
R2_S3_SECRET_ACCESS_KEY=replace_with_staging_r2_s3_secret
CLAUDE_API_KEY=replace_with_staging_claude_key
PEXELS_API_KEY=replace_with_staging_pexels_key
OPENAI_API_KEY=
