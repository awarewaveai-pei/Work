# Copy to .env on the server — never commit .env
#
# 「本機 .env.local vs 伺服器 .env」怎麼統一腦內模型 — 只認一份（輪替步驟）：
#   agency-os/docs/operations/hetzner-self-host-start-here.md → 環境變數唯一對照
#
# Redis auth (P2.4c hardening, 2026-08-30) — generate with: openssl rand -hex 32
# Consumed by both the `redis` service's --requirepass and node-api's REDIS_URL.
REDIS_PASSWORD=CHANGE_ME_openssl_rand_hex_32

# N8N_HOST = public hostname or IP users type in browser (no scheme)
N8N_HOST=YOUR_VPS_IP_OR_DOMAIN
N8N_WEBHOOK_URL=http://YOUR_VPS_IP_OR_DOMAIN/n8n/

# --- n8n URL layout (pick ONE; must match reverse proxy) ---
# Long-form matrix + MCP smoke TRY_ALT: agency-os/docs/operations/n8n-self-hosted-mcp-troubleshooting.md
# Pattern A — apex path /n8n/ (nginx snippets/lobster-aware-wave-locations.inc):
#   N8N_PATH=/n8n/
#   N8N_WEBHOOK_URL=https://aware-wave.com/n8n/
#   MCP URL for Cursor: https://aware-wave.com/n8n/mcp-server/http
# Pattern B — dedicated hostname n8n.aware-wave.com (apache/sites-available/n8n.conf, ProxyPass / → 5678):
#   N8N_PATH=/
#   N8N_HOST=n8n.aware-wave.com
#   N8N_WEBHOOK_URL=https://n8n.aware-wave.com/
#   MCP URL for Cursor: https://n8n.aware-wave.com/mcp-server/http
#
# REQUIRED — docker-compose has no default; Pattern B must set / here (not only comments) or MCP/webhooks mismatch.
N8N_PATH=/n8n/

# n8n image tag — use explicit semver or digest in production (see LONG_TERM_OPS.md).
N8N_IMAGE_TAG=2.18.5

WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wpuser
WORDPRESS_DB_PASSWORD=change_this_wp_password
WORDPRESS_DB_ROOT_PASSWORD=change_this_root_password

# Public origin for WordPress (root install behind Nginx). No trailing slash.
WORDPRESS_PUBLIC_URL=http://YOUR_VPS_IP_OR_DOMAIN

# Self-hosted Supabase API. If the caller runs on the host, localhost/127.0.0.1 is fine.
# If the caller runs inside Docker, localhost points at the container itself, so use a host-reachable address instead.
SUPABASE_URL=http://127.0.0.1:8000
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_service_role_key
# Server-only key for next-admin global events sync (/api/tools/events/sync).
CALENDARIFIC_API_KEY=replace_with_your_calendarific_api_key
# Optional override used by scripts/sync-events-monthly.sh.
NEXT_ADMIN_EVENTS_SYNC_URL=http://127.0.0.1:3002/api/tools/events/sync

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_your_anon_key

# Used by Next.js server components to call node-api inside Docker network
INTERNAL_API_BASE_URL=http://node-api:3001

# --- Ops Inbox (next-admin Path B) — optional until you wire webhooks / Slack / Gemini ---
# Bearer token for POST /api/webhooks/* (Authorization: Bearer …). Required for ingest in production.
# Still used by server-to-server / read endpoints (ops/probe, ops/inbox/digest|incidents,
# webhooks/deploy, webhooks/tenant-integration). The 5 monitoring webhooks below can move
# to per-source tokens (M2) — leave these empty to keep using the shared token above.
OPS_INBOX_INGEST_TOKEN=
# M2 per-source webhook tokens (blast-radius isolation). Empty = fall back to the shared
# token above (deploy-safe). Set each, point that platform's webhook Authorization header
# to it, then set OPS_INBOX_DUAL_ACCEPT_LEGACY=false once all five are migrated.
OPS_INBOX_SENTRY_TOKEN=
OPS_INBOX_GRAFANA_TOKEN=
OPS_INBOX_NETDATA_TOKEN=
OPS_INBOX_UPTIME_KUMA_TOKEN=
OPS_INBOX_POSTHOG_TOKEN=
# Migration window switch: "true" = also accept the legacy shared token on per-source
# endpoints while platforms are re-pointed; "false"/unset = per-source only (once set).
OPS_INBOX_DUAL_ACCEPT_LEGACY=
# M4 fingerprint salt (server-only secret). Empty = fingerprint_v2 mirrors the legacy
# fingerprint (no-op). Set a high-entropy value so an attacker who knows the payload
# cannot predict the fingerprint and pre-seed a collision. Rotating it re-keys all v2
# fingerprints (requires a backfill) — treat as stable once live.
OPS_INBOX_FINGERPRINT_SALT=
# Explicit off: false|0|no|off. Explicit on: true. If unset: on when OPS_INBOX_SLACK_INCIDENTS_WEBHOOK is set.
OPS_INBOX_NOTIFY_ENABLED=
# Incoming Slack webhook URL (incoming webhook app); keep server-only.
OPS_INBOX_SLACK_INCIDENTS_WEBHOOK=
# Public base URL of next-admin (no trailing slash); used in Slack links. Example: https://app.aware-wave.com
OPS_INBOX_PUBLIC_URL=
# Optional phone backup for curated Ops Inbox notifications. Sends only after the same dedup/throttle rules as Slack.
OPS_INBOX_TELEGRAM_NOTIFY_ENABLED=
OPS_INBOX_TELEGRAM_NOTIFY_MIN_SEVERITY=medium
# Optional override; defaults to TELEGRAM_ALLOWED_CHAT_IDS.
OPS_INBOX_TELEGRAM_CHAT_IDS=
# site-watch (agency-os/docs/operations/SITE_WATCH_MASTER_PLAN.md §3.4). Kill switch, default OFF:
# only "true" (or 1/on/yes) runs any check.
SITE_WATCH_ENABLED=false
# Own bearer for /api/internal/site-watch/* (Trigger heartbeat). Generate: openssl rand -hex 32.
SITE_WATCH_INGEST_TOKEN=
# Own bearer for /api/internal/schedules/run-due (Trigger schedules-heartbeat). Generate: openssl rand -hex 32.
SCHEDULE_INGEST_TOKEN=
# PRIVATE R2 bucket for screenshots; no default on purpose (never the public designs bucket).
R2_SITE_WATCH_BUCKET=
# Set to "true" to accept PostHog webhook payloads at /api/webhooks/posthog
OPS_INBOX_POSTHOG_ENABLED=
# Set to "true" to enable Gemini auto-classify path; requires GEMINI_API_KEY
OPS_INBOX_GEMINI_ENABLED=
OPS_INBOX_GEMINI_DAILY_LIMIT=1400
GEMINI_API_KEY=
# Shared secret for edge/reverse proxy to pass x-ops-proxy-auth (middleware). Required in production for trusted role headers.
OPS_PROXY_SHARED_SECRET=
# Leave empty for defaults; set OPS_ALLOW_SIMULATED_ROLE_FALLBACK=false to hard-disable simulated roles in prod.
OPS_ALLOW_SIMULATED_ROLE_FALLBACK=
# e.g. header | jwt — see lib/ops-role.ts
OPS_ROLE_RESOLUTION_MODE=
# Internal Basic Auth deployments without identity claims may set this to admin.
# Effective only when OPS_ALLOW_SIMULATED_ROLE_FALLBACK=true and fallback mode is enabled.
OPS_SIMULATED_FALLBACK_ROLE=
# Optional base for ops-console deep links (no trailing slash)
INTERNAL_ADMIN_BASE_URL=

OPENAI_API_KEY=replace_with_your_openai_api_key

# Sentry error tracking (recommended split-by-service; can point to same DSN if you want fewer projects)
# node-api (captures Supabase integration failures from node-api route handlers)
SENTRY_DSN_NODE_API=
# Trigger.dev workflows (set in Trigger project/env; local fallback can also read this key)
SENTRY_DSN_TRIGGER_WORKFLOWS=
# n8n backend (preferred explicit key; compose also supports N8N_SENTRY_DSN and legacy SENTRY_DSN_N8N)
SENTRY_DSN_N8N_BACKEND=
# n8n editor/frontend (optional; browser-side errors)
SENTRY_DSN_N8N_FRONTEND=
# Next.js admin frontend
SENTRY_DSN_NEXT_ADMIN=
# PostHog (cloud; optional — leave empty to disable client analytics)
# Used by next-admin and the WordPress public-site mu-plugin.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Optional: stable PostHog distinct_id for single-operator internal use (omit for multi-user / SSO later)
# NEXT_PUBLIC_POSTHOG_DISTINCT_ID=
# WordPress/PHP
SENTRY_DSN_WORDPRESS=

# Backward-compatible aliases (keep empty unless old scripts still read them)
SENTRY_DSN=
SENTRY_DSN_WP=
SENTRY_DSN_NEXT=

# Sentry — self-hosted n8n (backend + optional editor frontend)
# Create a Node.js (or dedicated) project in Sentry; leave empty to disable.
# Preferred key used directly by docker-compose.yml:
N8N_SENTRY_DSN=
# Preferred cross-stack alias for backend split:
SENTRY_DSN_N8N_BACKEND=
# Backward-compatible alias (older docs/scripts):
SENTRY_DSN_N8N=
# Optional: browser/editor errors; can be a separate Browser JS DSN or leave empty.
SENTRY_DSN_N8N_FRONTEND=
# Tags sent with n8n Sentry events (backend uses ENVIRONMENT / DEPLOYMENT_NAME in n8n)
N8N_SENTRY_ENVIRONMENT=staging
N8N_DEPLOYMENT_NAME=lobster-phase1-n8n
# 0 = traces/profiles off (recommended until you need performance data)
N8N_SENTRY_TRACES_SAMPLE_RATE=0
N8N_SENTRY_PROFILES_SAMPLE_RATE=0

# Grafana admin credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_this_grafana_password

# Resend email API (next-admin client account links: lib/mail/resend.ts)
RESEND_API_KEY=
# Sender for those links; empty = "AwareWave <noreply@${PUBLIC_BASE_DOMAIN:-aware-wave.com}>" (domain must be verified in Resend)
MAIL_FROM=

# Slack notifications (Uptime Kuma alerts + app use)
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=

# Telegram command plane + operator notification backup
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=
# Command Plane: single-owner org scope (UUID from Supabase organizations table)
# Required for ALL command plane routes. Get from: select id from public.organizations limit 1;
COMMAND_PLANE_DEFAULT_ORG_ID=
# Optional workspace scope. Leave empty for single-org deployments.
COMMAND_PLANE_DEFAULT_WORKSPACE_ID=
# Anthropic API key — required for /daily_review and /weekly_review AI summaries
# Without this, those commands return raw JSON fallback (not an error, just degraded)
ANTHROPIC_API_KEY=

# --- Repair Center (next-admin /ops/repairs) ---
# Prefer webhook if you have one. If empty, next-admin can use SSH fallback below.
AUTO_REPAIR_BACKUP_WEBHOOK_URL=
AUTO_REPAIR_BACKUP_WEBHOOK_TOKEN=
# SSH fallback pre-repair backup gate. Values are runtime secrets; never commit real keys.
AUTO_REPAIR_SG_SSH_HOST=
AUTO_REPAIR_SG_SSH_PORT=22
AUTO_REPAIR_SG_SSH_USER=root
AUTO_REPAIR_SG_SSH_KEY_B64=
AUTO_REPAIR_EU_SSH_HOST=
AUTO_REPAIR_EU_SSH_PORT=22
AUTO_REPAIR_EU_SSH_USER=root
AUTO_REPAIR_EU_SSH_KEY_B64=
AUTO_REPAIR_REQUIRE_EU_BACKUP=true
# Hosting bridge (provision-staging). Key's only power: scripts/aw-hosting-gate.sh forced command.
# HOST_KEY_SHA256 required (fail-closed): node scripts/fetch-ssh-host-key-fingerprint.mjs <host> <port>
HOSTING_BRIDGE_SSH_HOST=
HOSTING_BRIDGE_SSH_PORT=58122
HOSTING_BRIDGE_SSH_USER=root
HOSTING_BRIDGE_SSH_KEY_B64=
HOSTING_BRIDGE_SSH_HOST_KEY_SHA256=
# GitHub issue creation and Slack interactive callback verification.
AUTO_REPAIR_GITHUB_TOKEN=
AUTO_REPAIR_GITHUB_OWNER=awarewaveai-pei
AUTO_REPAIR_GITHUB_REPO=Work
SLACK_SIGNING_SECRET=

# --- Backup (backup-phase1.sh + verify-backup.sh) ---
# Output directory (absolute recommended for cron; default: ./backups relative to compose root)
# BACKUP_DIR=/var/backups/lobster-phase1
# Local retention in days (default: 7). Set 0 to disable cleanup.
# BACKUP_RETAIN_DAYS=7
# Offsite destination (rclone remote). Empty = skip offsite upload.
# Example: RCLONE_REMOTE=b2:my-bucket/lobster-phase1
# RCLONE_REMOTE=
# Slack webhook for backup failure alerts (default: reuses endpoint-alert WEBHOOK_URL)
# BACKUP_SLACK_WEBHOOK=

# Build Console (POST /api/build/runs enqueue) — optional: wake Trigger immediately so
# `dispatch-action-run` processes `ops_action_runs` without waiting for cron (~1 min).
# Use the same secret as Trigger.dev CLI / worker (Dashboard → API keys).
TRIGGER_SECRET_KEY=
# Management API base. Cloud: https://api.trigger.dev — self-host: your deployment’s API root (see infra/trigger README).
TRIGGER_API_URL=https://api.trigger.dev

# Postiz social publishing (Gate A 2026-06-22; POSTIZ_SOCIAL_PUBLISHING_PLAN.md)
POSTIZ_API_BASE_URL=https://postiz.aware-wave.com/api
POSTIZ_API_KEY=
