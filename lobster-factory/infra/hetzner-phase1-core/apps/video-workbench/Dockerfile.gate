# Deploy gate image (P6 L6): the just-built runtime image plus tests/, then tests/gate.cjs with no network. A failing
# test fails this build, so sg-deploy.sh stops before `up`. The runtime image itself stays test-free (.dockerignore).
# Context = this directory; Dockerfile.gate.dockerignore lets only tests/ in.
ARG BASE=lobster-phase1-video-workbench:local
FROM ${BASE}
COPY tests/ tests/
RUN --network=none node tests/gate.cjs
# The image must actually render, not just start Blender: a 16x16 Eevee frame (headless EGL; a missing GL/EGL library
# aborted every 3D render while `blender --version` passed, P6 H5).
RUN --network=none /opt/blender/blender -b --factory-startup --python-exit-code 1 --python-expr "import bpy; s=bpy.context.scene; s.render.engine='BLENDER_EEVEE_NEXT'; s.render.resolution_x=16; s.render.resolution_y=16; s.render.filepath='/tmp/eevee-gate.png'; bpy.ops.render.render(write_still=True)" \
    && test -s /tmp/eevee-gate.png
# The engine the CPU-only host uses (VW_BLENDER_ENGINE=cycles): one 16x16 Cycles frame.
RUN --network=none /opt/blender/blender -b -t 2 --factory-startup --python-exit-code 1 --python-expr "import bpy; s=bpy.context.scene; s.render.engine='CYCLES'; s.cycles.device='CPU'; s.cycles.samples=4; s.render.resolution_x=16; s.render.resolution_y=16; s.render.filepath='/tmp/cycles-gate.png'; bpy.ops.render.render(write_still=True)"     && test -s /tmp/cycles-gate.png
