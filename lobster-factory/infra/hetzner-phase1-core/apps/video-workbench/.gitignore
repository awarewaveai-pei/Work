# Machine-local, never committed (D:\Work is a public repo).
node_modules/
runtime/
.data/
.data-*/

# Captured from the third-party reference site seedstar.ai (images, prompts, card data).
# Operator's local reference only: not ours to republish. Keep a local copy beside the app.
assets/image-*
assets/storyboards-data.json
# Tests use assets/test-image-1.png and -2.png instead: our own (FFmpeg lavfi testsrc2 / color),
# flat under assets/ because the server only accepts /assets/<name> as a reference path.

# Copied from node_modules/@mediapipe/tasks-vision by scripts/vendor-vision.cjs (postinstall),
# SHA-256 checked against assets/vision/sources.json. LICENSE, sources.json and the model stay tracked.
assets/vision/vision_bundle.js
assets/vision/vision_bundle.mjs
assets/vision/wasm/

# Downloaded by scripts/vendor-ffprobe.cjs (postinstall), SHA-256 checked against vendor/ffprobe/sources.json (tracked).
vendor/ffprobe/ffprobe.exe

# Downloaded on demand by scripts/vendor-effectcraft.cjs, SHA-256 checked against engines/effectcraft/VERSION.json (tracked).
engines/effectcraft/web/

# Card P5: bytecode Blender may leave beside its job scripts (backend/blender.cjs also sets PYTHONDONTWRITEBYTECODE).
backend/blender/__pycache__/

# P6 L6: next-admin files copied by scripts/bundle-awarewave.cjs (sg-deploy / CI) for the container image.
.awarewave/
