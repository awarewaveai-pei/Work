[mysqld]
# ── Performance Schema ──────────────────────────────────────────────────────
# OFF: single-site admin tool, 1 connection; saves ~130 MiB RAM
performance_schema = OFF

# ── Binary Logging ──────────────────────────────────────────────────────────
# OFF: standalone instance, no replication; eliminates binlog I/O and disk growth
disable_log_bin

# ── Character Set ───────────────────────────────────────────────────────────
# utf8mb4_unicode_ci: WordPress/MainWP standard; full emoji + multilingual support
character_set_server = utf8mb4
collation_server     = utf8mb4_unicode_ci

# ── Connections ─────────────────────────────────────────────────────────────
# 20: 1 app + cron + admin headroom; default 151 pre-allocates unnecessary buffers
max_connections = 20

# ── Table Cache ─────────────────────────────────────────────────────────────
# 256: WordPress ~50 tables with safe headroom; default 4000 is wasteful
table_open_cache = 256

# ── InnoDB Buffer Pool ──────────────────────────────────────────────────────
# 128M = 33% of 384M container limit; right-sized for read-light admin workload
innodb_buffer_pool_size = 128M

# ── InnoDB Log Buffer ───────────────────────────────────────────────────────
# 8M: sufficient for low-concurrency writes; saves 8M vs default 16M
innodb_log_buffer_size = 8M

# ── Temporary Tables ────────────────────────────────────────────────────────
# 32M: prevents disk spill during MainWP bulk-sync operations (default 16M too tight)
tmp_table_size      = 32M
max_heap_table_size = 32M

# ── Slow Query Log (replaces performance_schema for diagnostics) ─────────────
# Zero memory overhead; captures any future performance issue for debugging
slow_query_log      = ON
slow_query_log_file = /var/lib/mysql/slow-queries.log
long_query_time     = 2
log_queries_not_using_indexes = OFF

# ── Network ─────────────────────────────────────────────────────────────────
# Skip DNS reverse lookup; faster auth, already correct at runtime
skip_name_resolve = ON
