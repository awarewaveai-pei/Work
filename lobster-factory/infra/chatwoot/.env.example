# Chatwoot .env — copy to /root/chatwoot/.env on the server, fill real values, NEVER commit.
# Vault-source-of-truth: put the same 3 secrets into scripts/secrets-vault.ps1 under names
# CHATWOOT_SECRET_KEY_BASE / CHATWOOT_POSTGRES_PASSWORD / CHATWOOT_REDIS_PASSWORD so they survive a
# machine rebuild (AGENTS.md 禁硬編 — this file is the deployed copy, not the source of truth).

# Generate with: openssl rand -hex 64
SECRET_KEY_BASE=

# Independent random strings (openssl rand -hex 32 each) — do NOT reuse across services.
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Internal, container-network-only — matches chatwoot-postgres/chatwoot-redis service names in
# docker-compose.yml. Not host-reachable (no port mapping on either container).
POSTGRES_HOST=chatwoot-postgres
POSTGRES_USERNAME=chatwoot
REDIS_URL=redis://:${REDIS_PASSWORD}@chatwoot-redis:6379

FRONTEND_URL=https://chatwoot.aware-wave.com
RAILS_ENV=production
INSTALLATION_ENV=docker
RAILS_MAX_THREADS=5
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info

# Signup must stay closed — every account is agency-provisioned (Account#0 canary first, D2).
ENABLE_ACCOUNT_SIGNUP=false

# SMTP — required for agent invite emails / notification emails to actually send. Point at the
# same Resend (or existing SMTP relay) credentials already in mcp/user-env.ps1; do not re-derive a
# new provider just for this service.
MAILER_SENDER_EMAIL=AwareWave 客服 <cs@aware-wave.com>
SMTP_DOMAIN=aware-wave.com
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true
