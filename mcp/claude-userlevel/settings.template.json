{
  "_comment": "AwareWave Claude Code user-level settings template (cross-machine SSOT). Variables: ${USERPROFILE}, ${USERPROFILE_FORWARD}, ${MONOREPO_ROOT}, ${MONOREPO_ROOT_FORWARD}. Sync via scripts/sync-claude-userlevel.ps1.",
  "autoUpdatesChannel": "latest",
  "theme": "light",
  "model": "claude-sonnet-4-6",
  "permissions": {
    "_defaultMode_comment": "bypassPermissions = no per-command prompts. Only valid in user-level ~/.claude/settings.json (Claude Code ignores it in project-shared .claude/settings.json for safety). 'skipDangerousModePermissionPrompt' suppresses the one-time entry confirmation. Hard guardrails come from 'deny' below + the governance runner rules (hooks/rules/branch-protection.js, hooks/rules/dangerous-bash.js — see hooks/rules.manifest.json). See mcp/claude-userlevel/README.md.",
    "defaultMode": "bypassPermissions",
    "skipDangerousModePermissionPrompt": true,
    "allow": [
      "Bash(powershell *)",
      "Bash(powershell.exe *)",
      "Bash(pwsh *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(gh pr merge *)",
      "Bash(git checkout -b *)",
      "Bash(git switch -c *)",
      "Bash(git switch --create *)",
      "Bash(git branch *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm --recursive --force *)",
      "Bash(git reset --hard origin/*)",
      "Bash(git reset --hard HEAD~*)",
      "Bash(git clean -fd*)",
      "Bash(git clean -df*)",
      "Bash(sudo *)",
      "Bash(rmdir /s *)",
      "Bash(rd /s *)",
      "Bash(format *)",
      "Bash(mkfs.* *)",
      "Bash(:(){ *)"
    ],
    "additionalDirectories": [
      "${USERPROFILE}\\AppData\\Roaming\\Claude",
      "${USERPROFILE}",
      "${MONOREPO_ROOT}",
      "\\tmp"
    ]
  },
  "hooks": {
    "_comment": "Portable governance hooks run through ONE runner (hooks/runner.js); the event→rules wiring lives in hooks/rules.manifest.json — never enumerate hooks here. Only machine-level PowerShell automations (AO-RESUME trigger, post-push deploy) are wired directly.",
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File ~/.claude/hooks/ao-resume-on-prompt.ps1",
            "timeout": 1200
          },
          {
            "type": "command",
            "command": "node ~/.claude/hooks/runner.js UserPromptSubmit",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/runner.js PreToolUse",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/runner.js PostToolUse",
            "timeout": 90
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git push*)",
            "command": "powershell.exe -NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File ~/.claude/hooks/post-push-trigger-deploy.ps1",
            "timeout": 360000,
            "statusMessage": "Checking if Trigger.dev auto-deploy is needed..."
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/runner.js PostToolUseFailure",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/runner.js Stop",
            "timeout": 300
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/runner.js SessionStart",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
