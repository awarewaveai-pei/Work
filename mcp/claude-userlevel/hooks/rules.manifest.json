{
  "_comment": "SSOT wiring for the hook runner (runner.js). Event → matcher-groups → ordered rule names (rules/<name>.js). This file is the ONLY place hooks are enumerated — settings.template.json, hooks.json and the remote generator all just invoke `node runner.js <event>`. Matcher is an unanchored regex on tool_name (same semantics Claude Code applies to its own matcher field); omit it to match every tool. Do not hand-write hook counts anywhere: the session-banner rule derives counts from this file.",
  "events": {
    "PreToolUse": [
      {
        "rules": [
          "permission-deny-mirror"
        ]
      },
      {
        "matcher": "Bash",
        "rules": [
          "dangerous-bash",
          "branch-protection",
          "commit-quality",
          "verify-gate-commit",
          "high-risk-bash-warn",
          "git-add-scope-tracker",
          "git-commit-scope-guard",
          "git-shared-file-guard",
          "repeat-failure-guard",
          "file-claim-guard"
        ]
      },
      {
        "matcher": "^Agent$",
        "rules": [
          "subagent-budget",
          "subagent-charter"
        ]
      },
      {
        "matcher": "^Workflow$",
        "rules": [
          "subagent-budget"
        ]
      },
      {
        "matcher": "Write|Edit",
        "rules": [
          "sensitive-file-block",
          "file-claim-guard",
          "git-log-injector",
          "worklog-entry-number-guard",
          "auto-repair-guard",
          "config-protection",
          "file-path-router"
        ]
      },
      {
        "matcher": "^mcp__",
        "rules": [
          "mcp-health"
        ]
      },
      {
        "matcher": "^Read$",
        "rules": [
          "large-file-warner",
          "read-sweep-to-codex"
        ]
      }
    ],
    "PostToolUse": [
      {
        "rules": [
          "log-error"
        ]
      },
      {
        "matcher": "Bash",
        "rules": [
          "audit-log",
          "git-add-scope-tracker",
          "git-commit-scope-guard",
          "repeat-failure-guard",
          "doc-link-commit-check",
          "file-claim-guard"
        ]
      },
      {
        "matcher": "Write|Edit",
        "rules": [
          "accumulator",
          "design-quality",
          "test-runner",
          "code-change-tracker",
          "session-edit-tracker",
          "file-claim-guard"
        ]
      },
      {
        "matcher": "^Agent$",
        "rules": [
          "agent-dispatch-log"
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^mcp__",
        "rules": [
          "mcp-health"
        ]
      },
      {
        "matcher": "Bash",
        "rules": [
          "repeat-failure-guard",
          "file-claim-guard"
        ]
      },
      {
        "matcher": "Write|Edit",
        "rules": [
          "file-claim-guard"
        ]
      }
    ],
    "Stop": [
      {
        "rules": [
          "batch-format",
          "check-console",
          "cost-tracker",
          "session-summary",
          "verify-gate-stop"
        ]
      }
    ],
    "SessionStart": [
      {
        "rules": [
          "session-banner"
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "rules": [
          "vbc-reminder",
          "suggest-compact"
        ]
      }
    ],
    "SubagentStart": [
      {
        "rules": [
          "subagent-charter"
        ]
      }
    ]
  }
}
