{
  "description": "Claude Code governance hooks — plugin wiring. All judgment logic lives in rules/ and is enumerated ONLY in rules.manifest.json (do not hand-write hook counts anywhere; the SessionStart banner derives them). Each event invokes the single runner, which dispatches by tool_name, isolates rule failures (structural fail-open), and aggregates block verdicts. Companion wiring: settings.template.json (user-level machines) and scripts/wire-remote-hooks.sh (remote containers).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/runner.js PreToolUse",
            "timeout": 60,
            "description": "Governance runner — PreToolUse rules (see rules.manifest.json)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/runner.js PostToolUse",
            "timeout": 90,
            "description": "Governance runner — PostToolUse rules (see rules.manifest.json)"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/runner.js PostToolUseFailure",
            "timeout": 30,
            "description": "Governance runner — failure tracking (see rules.manifest.json)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/runner.js Stop",
            "timeout": 300,
            "description": "Governance runner — Stop rules (see rules.manifest.json)"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/runner.js SessionStart",
            "timeout": 15,
            "description": "Governance runner — session banner (counts derived from rules.manifest.json)"
          }
        ]
      }
    ]
  }
}
